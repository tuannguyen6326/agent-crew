{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "\"$CURSOR_PROJECT_DIR\"/bin/ac-sessionstart-nudge.sh",
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "type": "command",
        "command": "\"$CURSOR_PROJECT_DIR\"/bin/ac-watch-policy-cursor.sh",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "type": "command",
        "command": "\"$CURSOR_PROJECT_DIR\"/bin/ac-turnend-guard-cursor.sh",
        "timeout": 30,
        "loop_limit": 5
      }
    ]
  }
}
